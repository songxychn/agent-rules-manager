{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Rules Manager",
  "version": "0.1.0",
  "identifier": "com.baizhukui.agent-rules-manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Rules Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Baizhukui",
    "copyright": "Copyright (c) 2026 Baizhukui",
    "category": "DeveloperTool",
    "shortDescription": "Local-first rules manager for coding agents",
    "longDescription": "Manage machine-local rule profiles and project them safely onto Codex, Claude Code, Cursor, Copilot, and other coding agents. Preview every write, back up existing files before takeover, and refuse rollback when files have drifted.",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMjVDOTM5RUZERkQyQzMKUldURDB0L3ZPY2tsdkhEVW50ODJNT1o1NzY3R1RzdG04eUtTcXg4TXF4emZQb21ZeHpWaUxxSXcK",
      "endpoints": [
        "https://github.com/songxychn/agent-rules-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
